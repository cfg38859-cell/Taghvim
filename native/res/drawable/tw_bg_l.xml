<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FFFFFEF8" android:centerColor="#FFF5F0E3" android:endColor="#FFE9E1CF" android:type="linear"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#66FFFFFF" android:centerColor="#00FFFFFF" android:centerY="0.4" android:endColor="#0F8A6A2A"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#88B58A4A"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
</layer-list>
