<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF12936F" android:centerColor="#FF0A5A47" android:endColor="#FF042B22" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#38FFFFFF" android:centerColor="#00FFFFFF" android:centerY="0.45" android:endColor="#14000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#77F3D58A" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
