<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/tw_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl">
<ImageView android:id="@+id/tw_bgl" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/tw_bg_prayer" android:visibility="gone"/>
<ImageView android:id="@+id/tw_bgd" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/tw_bg_prayer"/>
<ImageView android:id="@+id/tw_bgs" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/tw_bg_g1" android:visibility="gone"/>
<ImageView android:id="@+id/tw_deco" android:layout_width="150dp" android:layout_height="150dp" android:layout_gravity="bottom|left" android:layout_marginLeft="-42dp" android:layout_marginBottom="-42dp" android:scaleType="fitCenter" android:src="@drawable/tw_star" android:alpha="1" android:visibility="gone"/>

<LinearLayout android:id="@+id/tw_body" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:layoutDirection="rtl" android:padding="9dp" android:gravity="center_vertical">

  <LinearLayout android:id="@+id/tw_right" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.15" android:layout_marginLeft="8dp" android:orientation="vertical">

    <LinearLayout android:id="@+id/tw_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:background="@drawable/tw_card" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="4dp" android:paddingBottom="5dp">
      <TextView android:id="@+id/tw_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" android:textColor="#FFF2CF85" android:gravity="center" android:includeFontPadding="false" android:maxLines="1"/>
      <TextView android:id="@+id/tw_at" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:gravity="center" android:includeFontPadding="false" android:maxLines="1"/>
      <FrameLayout android:id="@+id/tw_pbw" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="3dp">
        <ProgressBar android:id="@+id/tw_pbl" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:max="1000" android:progress="0" android:indeterminate="false" android:progressDrawable="@drawable/tw_pb_l" android:visibility="gone"/>
        <ProgressBar android:id="@+id/tw_pbd" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:max="1000" android:progress="0" android:indeterminate="false" android:progressDrawable="@drawable/tw_pb_d"/>
      </FrameLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/tw_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:orientation="vertical">

      <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layoutDirection="rtl">
        <LinearLayout android:id="@+id/tw_pc0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:orientation="horizontal" android:gravity="center" android:layoutDirection="rtl" android:background="@drawable/tw_cell"><TextView android:id="@+id/tw_pn0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="3dp" android:textSize="11sp" android:textColor="#FFF2CF85" android:includeFontPadding="false" android:maxLines="1"/><TextView android:id="@+id/tw_pt0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:maxLines="1"/></LinearLayout>
        <LinearLayout android:id="@+id/tw_pc1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:orientation="horizontal" android:gravity="center" android:layoutDirection="rtl" android:background="@drawable/tw_cell"><TextView android:id="@+id/tw_pn1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="3dp" android:textSize="11sp" android:textColor="#FFF2CF85" android:includeFontPadding="false" android:maxLines="1"/><TextView android:id="@+id/tw_pt1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:maxLines="1"/></LinearLayout>
      </LinearLayout>

      <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layoutDirection="rtl">
        <LinearLayout android:id="@+id/tw_pc2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:orientation="horizontal" android:gravity="center" android:layoutDirection="rtl" android:background="@drawable/tw_cell"><TextView android:id="@+id/tw_pn2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="3dp" android:textSize="11sp" android:textColor="#FFF2CF85" android:includeFontPadding="false" android:maxLines="1"/><TextView android:id="@+id/tw_pt2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:maxLines="1"/></LinearLayout>
        <LinearLayout android:id="@+id/tw_pc3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:orientation="horizontal" android:gravity="center" android:layoutDirection="rtl" android:background="@drawable/tw_cell"><TextView android:id="@+id/tw_pn3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="3dp" android:textSize="11sp" android:textColor="#FFF2CF85" android:includeFontPadding="false" android:maxLines="1"/><TextView android:id="@+id/tw_pt3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:maxLines="1"/></LinearLayout>
      </LinearLayout>

      <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layoutDirection="rtl">
        <LinearLayout android:id="@+id/tw_pc4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:orientation="horizontal" android:gravity="center" android:layoutDirection="rtl" android:background="@drawable/tw_cell"><TextView android:id="@+id/tw_pn4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="3dp" android:textSize="11sp" android:textColor="#FFF2CF85" android:includeFontPadding="false" android:maxLines="1"/><TextView android:id="@+id/tw_pt4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:maxLines="1"/></LinearLayout>
        <LinearLayout android:id="@+id/tw_pc5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:orientation="horizontal" android:gravity="center" android:layoutDirection="rtl" android:background="@drawable/tw_cell"><TextView android:id="@+id/tw_pn5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="3dp" android:textSize="11sp" android:textColor="#FFF2CF85" android:includeFontPadding="false" android:maxLines="1"/><TextView android:id="@+id/tw_pt5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:maxLines="1"/></LinearLayout>
      </LinearLayout>

    </LinearLayout>
  </LinearLayout>

  <LinearLayout android:id="@+id/tw_left" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
    <TextView android:id="@+id/tw_dt" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFF2CF85" android:gravity="center" android:includeFontPadding="false" android:maxLines="1"/>
    <TextView android:id="@+id/tw_city" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textSize="10sp" android:textColor="#FFB9C3E6" android:gravity="center" android:includeFontPadding="false" android:maxLines="1"/>
    <TextClock android:id="@+id/tw_clk" android:layout_width="match_parent" android:layout_height="wrap_content" android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textSize="34sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:gravity="center" android:includeFontPadding="false"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layoutDirection="rtl" android:gravity="center">
      <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
        <Chronometer android:id="@+id/tw_chr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false"/>
        <TextView android:id="@+id/tw_cd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:includeFontPadding="false" android:visibility="gone"/>
      </FrameLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="4dp" android:text="تا اذان" android:textSize="10sp" android:textColor="#FFB9C3E6" android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/tw_brand" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:orientation="horizontal" android:layoutDirection="rtl" android:gravity="center">
      <ImageView android:layout_width="16dp" android:layout_height="16dp" android:scaleType="fitCenter" android:src="@mipmap/ic_launcher"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="4dp" android:text="شفیع" android:textSize="11sp" android:textStyle="bold" android:textColor="#FFF2CF85" android:includeFontPadding="false"/>
    </LinearLayout>
  </LinearLayout>

</LinearLayout>
<TextView android:id="@+id/tw_msg" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="16dp" android:textSize="13sp" android:visibility="gone"/>
</FrameLayout>
